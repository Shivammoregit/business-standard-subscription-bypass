{
  "manifest_version": 3,
  "name": "BS Article Unblocker & Full Reader",
  "version": "1.2.0",
  "description": "Automatically unlocks full articles, removes meter paywalls, and restores all paragraphs on Business Standard (both AMP and non-AMP URLs) with an On/Off toggle.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "*://*.business-standard.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BS Article Unblocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.business-standard.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ]
}
